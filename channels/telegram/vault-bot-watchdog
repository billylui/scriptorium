#!/usr/bin/python3
"""Restarts the Telegram vault bot when Telegram is holding messages it has stopped fetching.

The channel plugin long-polls Telegram. If that poll silently stalls (seen after a network
change: messages sat undelivered for 35 minutes while the session was idle), nothing errors
and nothing recovers. Telegram's getWebhookInfo reports pending_update_count, the updates
waiting to be fetched; a healthy poller drains it within seconds, even while Claude is busy.

Run it every minute (launchd or cron) with VAULT_WATCHDOG_RESTART set to the shell command
that restarts your bot session. If updates stay pending for STUCK seconds, it restarts the bot
(messages still waiting at Telegram are kept and arrive in the new session; the old session's
chat context and any task in progress are lost), then waits COOLDOWN before it may
restart again. If Telegram itself is unreachable it does nothing: a restart cannot fix the
network, and it cannot tell a stall from an outage. It logs only changes, not every check.
"""
import hashlib, json, os, signal, subprocess, time
from datetime import datetime
from urllib import request

HOME = os.path.expanduser("~")
TG = os.environ.get("TELEGRAM_STATE_DIR", os.path.join(HOME, ".claude/channels/telegram"))
API = os.environ.get("VAULT_BOT_TG_API", "https://api.telegram.org")
# one state file per bot, so two bots never reset each other's timers
_bot = os.path.basename(os.path.abspath(TG)) + "-" + hashlib.sha1(os.path.abspath(TG).encode()).hexdigest()[:6]
STATE = os.environ.get("VAULT_WATCHDOG_STATE", os.path.join(HOME, ".local/share/vault-bot-watchdog-%s.json" % _bot))
RESTART = os.environ.get("VAULT_WATCHDOG_RESTART")  # shell command that restarts the bot session
TIMEOUT = float(os.environ.get("VAULT_WATCHDOG_TIMEOUT") or 60)  # seconds the restart command may take
STUCK, COOLDOWN = 120, 600
GAP = 150  # a longer silence between good checks (sleep, outage) restarts the stall timer


def log(now, msg):
    print("%s watchdog: %s" % (datetime.fromtimestamp(now).strftime("%F %T"), msg), flush=True)


def save(st, now):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, STATE)
        return True
    except OSError as e:
        log(now, "cannot save %s (%s)" % (STATE, e))
        return False


def restart(now):
    # its own process group, so a timeout can kill everything it started, not just the shell
    p = subprocess.Popen(RESTART, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, start_new_session=True)
    try:
        out, _ = p.communicate(timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        log(now, "restart command timed out after %gs and was killed" % TIMEOUT)
        return
    if p.returncode != 0:
        log(now, "restart command failed (exit %d): %s" % (p.returncode, out.strip()[-300:]))


def main():
    now = float(os.environ.get("VAULT_WATCHDOG_NOW") or time.time())  # fixed clock for tests only
    try:
        with open(STATE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    try:
        with open(os.path.join(TG, ".env")) as f:
            token = next(l.split("=", 1)[1].strip() for l in f if l.startswith("TELEGRAM_BOT_TOKEN="))
    except (OSError, StopIteration):
        if not st.get("no_token"):
            log(now, "no TELEGRAM_BOT_TOKEN in %s; set TELEGRAM_STATE_DIR to the bot's state directory" % TG)
            st["no_token"] = True
            save(st, now)
        return
    st["no_token"] = False

    try:
        with request.urlopen(API + "/bot" + token + "/getWebhookInfo", timeout=15) as resp:
            pending = int(json.load(resp)["result"]["pending_update_count"])
    except Exception as e:
        if not st.get("unreachable"):
            log(now, "Telegram unreachable (%s); not acting until it answers" % e.__class__.__name__)
        st["unreachable"] = True  # a failed check proves nothing either way; the stall timer keeps running
    else:
        if st.get("unreachable"):
            log(now, "Telegram reachable again")
        if st.get("pending_since") is not None and now - st.get("last_ok", now) > GAP:
            st["pending_since"] = None
        st.update(unreachable=False, last_ok=now)
        if pending == 0:
            st["pending_since"] = None
        elif st.get("pending_since") is None:
            st["pending_since"] = now
        elif now - st["pending_since"] >= STUCK and now - st.get("last_restart", -COOLDOWN) >= COOLDOWN:
            stalled = "%d update(s) undelivered for %ds" % (pending, now - st["pending_since"])
            st.update(last_restart=now, pending_since=None)
            # save the cooldown first: if it cannot be saved, every run would restart again
            if not save(st, now):
                log(now, stalled + "; not restarting because the cooldown could not be saved")
            elif RESTART:
                log(now, stalled + "; restarting the bot")
                restart(now)
            else:
                log(now, stalled + "; set VAULT_WATCHDOG_RESTART to let the watchdog restart the bot")
            return

    save(st, now)


if __name__ == "__main__":
    main()
